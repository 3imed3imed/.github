# ============================================================================
# Crime YouTube Factory — environment configuration
# Copy to `.env` for local dev. In production, put these in GitHub Secrets.
# NEVER commit a real .env. NEVER store website passwords here — OAuth/API only.
# ============================================================================

# ---------------------------------------------------------------------------
# SAFETY GATES (default to the safest values — change deliberately)
# ---------------------------------------------------------------------------
# Hard cost rule: no paid provider call happens unless this is exactly "true".
ALLOW_PAID_SERVICES=false
# Optional hard cap (¥). 0 = zero-cost operation.
MONTHLY_COST_CAP_YEN=0

# Publication rollout: render -> private upload -> scheduled public.
UPLOAD_ENABLED=false
# Must ONLY be set to true by the owner after validation Stages A–C.
PUBLIC_AUTO_PUBLISH=false

# ---------------------------------------------------------------------------
# SCORING / VERIFICATION THRESHOLDS
# ---------------------------------------------------------------------------
MIN_STORY_SCORE=75
PREFERRED_STORY_SCORE=85
MIN_SOURCES=3
MAX_SOURCE_SIMILARITY=0.35

# ---------------------------------------------------------------------------
# VISUAL MIX (fractions, configurable)
# ---------------------------------------------------------------------------
MIX_AI_RECONSTRUCTION=0.15
MIX_STOCK=0.40
MIX_RECORDS=0.25
MIX_STILLS_MOTION=0.20

# ---------------------------------------------------------------------------
# LLM — OpenRouter (free models only by default)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_FALLBACK_MODELS=google/gemma-2-9b-it:free,mistralai/mistral-7b-instruct:free

# ---------------------------------------------------------------------------
# STOCK MEDIA (free tiers)
# ---------------------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------------------------------------------------------------------------
# LEGAL VERIFICATION — CourtListener (works anonymously; token raises limits)
# ---------------------------------------------------------------------------
COURTLISTENER_API_TOKEN=

# ---------------------------------------------------------------------------
# AI VIDEO — Agnes (optional, experimental; system works without it)
# ---------------------------------------------------------------------------
AGNES_API_KEY=
AGNES_BASE_URL=https://api.agnes.ai/v1

# ---------------------------------------------------------------------------
# TTS — Edge TTS is free and needs no key
# ---------------------------------------------------------------------------
TTS_PROVIDER=edge
TTS_VOICE=en-US-ChristopherNeural

# Music/ambience: a subtle, procedurally-generated, license-clean bed is mixed
# under narration and auto-ducked. Set false to narrate over silence.
MUSIC_BED_ENABLED=true
# Target integrated loudness for the final mix (LUFS).
TARGET_LUFS=-14.0

# ---------------------------------------------------------------------------
# YOUTUBE — OAuth refresh token only (NEVER a Google password)
# ---------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PLAYLIST_ID=

# ---------------------------------------------------------------------------
# GITHUB — for automated failure Issues (Actions provides GITHUB_TOKEN)
# ---------------------------------------------------------------------------
# GITHUB_TOKEN is injected by Actions; set GITHUB_REPOSITORY as owner/repo.
GITHUB_REPOSITORY=

# ---------------------------------------------------------------------------
# MISC
# ---------------------------------------------------------------------------
TZ=Asia/Tokyo
# DATA_DIR=./data
# PROJECTS_DIR=./projects
